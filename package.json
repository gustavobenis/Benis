{
  "name": "marieta-a-grande-aventura",
  "private": true,
  "version": "0.1.0",
  "description": "Marieta: A Grande Aventura na Mata — jogo 3D de navegador (Babylon.js + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.0"
  }
}
